{
  "expo": {
    "name": "Akiya Emp",
    "slug": "akiya-employee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/akiya-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/akiya-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/akiya-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.amanuelasfaw.akiyaemployee"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ab57897e-4b10-433b-848b-595d67b62112"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      "@react-native-community/datetimepicker"
    ]
  }
}
